blur {
    on
    passes 4      // number of times to apply the blur effect (default: 3)
    offset 1.0    // sample distance per pass (acts as your radius) (default: 3.0)
    noise 0       // add grain to the blur (default: 0.02)
    saturation 2 // optional: boost color saturation
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 2500
}

layout {
    gaps 4
    // fullscreen {
    //     gaps 1 
    // }
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33
        proportion 0.5
        proportion 0.66
        proportion 0.8
    }

    default-column-width { proportion 1.0; }
    
    focus-ring {
        width 1
    }

    border {
        off
        width 0
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

animations {
    workspace-switch {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.0001
    }

    window-open {
        spring damping-ratio=0.7 stiffness=700 epsilon=0.0001
    }

    window-close {
        spring damping-ratio=0.7 stiffness=700 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=600 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.8 stiffness=700 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=800 epsilon=0.0001
    }
}
