{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭───────────╮"
    },
    {
      "type": "title",
      "key": "│  user    │",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰇅 hname   │",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 uptime  │"
    },
    {
      "type": "os",
      "key": "│  distro  │"
    },
    {
      "type": "kernel",
      "key": "│  kernel  │"
    },
    {
      "type": "terminal",
      "key": "│  term    │"
    },
    {
      "type": "shell",
      "key": "│  shell   │"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 cpu     │"
    },
    {
      "type": "disk",
      "key": "│ 󰉉 disk    │",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│  memory  │"
    },
    {
      "type": "localip",
      "key": "│ 󰩟 network │",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "custom",
      "format": "├───────────┤"
    },
    {
      "type": "colors",
      "key": "│  colors  │",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰───────────╯"
    }
  ]
}
